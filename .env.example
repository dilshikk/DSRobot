# --- Telegram ---
BOT_TOKEN=123456:AAExampleTokenReplaceMe
# Комментарии только на отдельных строках: в .env текст после значения может попасть в само значение.
# id бота (для клонов / самоидентификации).
BOT_ID=123456
# id канала/группы поддержки для @admin. Пусто = не используется.
SUPPORT_CHAT_ID=

# --- Roles ---
# Telegram id через запятую, кто получает роль developer (глобальный супер-админ) во всех чатах.
DEVELOPER_USER_IDS=

# --- Clones ---
# Ключ шифрования токенов клонов. Без него клоны отключены.
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Храните отдельно от бэкапов БД. При потере ключа клоны придётся добавить заново.
CLONE_ENCRYPTION_KEY=
# Telegram id через запятую, кому разрешено /addclone. Пусто = никому.
CLONE_ALLOWED_USER_IDS=
MAX_CLONES_PER_USER=1

# --- Database ---
# Обязательно замените пароль. Сгенерировать: openssl rand -hex 24
POSTGRES_USER=botuser
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24
POSTGRES_DB=botdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
# Обязательно задайте пароль. Сгенерировать: openssl rand -hex 24
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_24

# --- Misc ---
DEFAULT_LANG=ru
LOG_LEVEL=INFO
SENTRY_DSN=
CRYPTO_API_URL=https://api.coingecko.com/api/v3/simple/price
